---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteHeader from '@/components/layout/SiteHeader.astro';
import SiteFooter from '@/components/layout/SiteFooter.astro';
import { groupedByCategory, allTools } from '@/lib/registry';
import { getIcon } from '@/lib/icons';

const groups = groupedByCategory();
const total = allTools.length;
const Ico = getIcon;

// 每个分类分配一个辅助色
const categoryColors: Record<string, { icon: string; iconBg: string; hover: string }> = {
  encoding:  { icon: 'text-blue-500',   iconBg: 'bg-blue-500/10',   hover: 'group-hover:text-blue-500' },
  json:      { icon: 'text-emerald-500', iconBg: 'bg-emerald-500/10', hover: 'group-hover:text-emerald-500' },
  crypto:    { icon: 'text-purple-500',  iconBg: 'bg-purple-500/10',  hover: 'group-hover:text-purple-500' },
  datetime:  { icon: 'text-orange-500',  iconBg: 'bg-orange-500/10',  hover: 'group-hover:text-orange-500' },
  generator: { icon: 'text-cyan-500',    iconBg: 'bg-cyan-500/10',    hover: 'group-hover:text-cyan-500' },
  image:     { icon: 'text-pink-500',    iconBg: 'bg-pink-500/10',    hover: 'group-hover:text-pink-500' },
  text:      { icon: 'text-amber-500',   iconBg: 'bg-amber-500/10',   hover: 'group-hover:text-amber-500' },
  network:   { icon: 'text-teal-500',    iconBg: 'bg-teal-500/10',    hover: 'group-hover:text-teal-500' },
  dev:       { icon: 'text-indigo-500',  iconBg: 'bg-indigo-500/10',  hover: 'group-hover:text-indigo-500' },
};
const defaultColor = { icon: 'text-primary', iconBg: 'bg-primary/10', hover: 'group-hover:text-primary' };
---

<BaseLayout home>
  <SiteHeader />

  <main class="flex-1">
    <!-- Hero -->
    <section class="container pt-6 pb-8">
      <div class="max-w-2xl">
        <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-emerald-500/20 bg-emerald-500/10 px-3 py-1 text-xs font-medium text-emerald-600 dark:text-emerald-400">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          数据 100% 本地处理
        </div>
        <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">
          开发者<span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-500 to-emerald-500">浏览器工具箱</span>
        </h1>
        <p class="mt-3 text-muted-foreground leading-relaxed">
          {total} 个常用工具，无需安装、无需注册、数据不离开你的设备。开源免费。
        </p>
      </div>
    </section>

    <!-- 工具分类网格 -->
    <section class="container space-y-12 pb-20">
      {groups.map((g) => {
        const CatIcon = Ico(g.category.icon);
        const colors = categoryColors[g.category.id] ?? defaultColor;
        return (
          <div id={g.category.id}>
            <div class="mb-4 flex items-center gap-2.5">
              <span class={`inline-flex h-7 w-7 items-center justify-center rounded-md ${colors.iconBg}`}>
                <CatIcon size={14} class={colors.icon} />
              </span>
              <h2 class="text-sm font-semibold text-foreground">
                {g.category.i18n.zh.title}
              </h2>
              <span class="ml-1 rounded-full bg-secondary px-2 py-0.5 text-[11px] text-muted-foreground">
                {g.tools.length}
              </span>
            </div>

            <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
              {g.tools.map((t) => {
                const ToolIco = Ico(t.icon);
                return (
                  <a href={`/${t.id}`} class="group tool-card cursor-pointer">
                    <div class="flex items-center gap-3">
                      <span class={`inline-flex h-8 w-8 flex-none items-center justify-center rounded-md bg-secondary text-muted-foreground transition-colors ${colors.hover}`}>
                        <ToolIco size={15} />
                      </span>
                      <div class="min-w-0 flex-1">
                        <p class="truncate text-sm font-medium text-foreground">{t.i18n.zh.title}</p>
                        <p class="truncate text-xs text-muted-foreground mt-0.5">
                          {t.i18n.zh.description}
                        </p>
                      </div>
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
        );
      })}
    </section>
  </main>

  <SiteFooter />

  <script is:inline>
    document.getElementById('hero-open-palette')?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('wetools:openPalette'));
    });
  </script>
</BaseLayout>
