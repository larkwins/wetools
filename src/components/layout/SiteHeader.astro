---
import ThemeToggle from '@/components/layout/ThemeToggle.vue';
import SearchTrigger from '@/components/layout/SearchTrigger.vue';
import LangSwitch from '@/components/layout/LangSwitch.vue';
import { groupedByCategory } from '@/lib/registry';
import { Menu } from 'lucide-vue-next';

const groups = groupedByCategory();
---

<header class="fixed top-0 left-0 right-0 z-50 h-14 border-b border-border/60 bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/80">
  <!-- 桌面端 (xl+)：所有元素紧凑排列，整体水平居中（语言切换后宽度变化不会让两端贴边）
       移动端：保持 logo 左、汉堡 + 右侧操作组在右的传统布局 -->
  <div class="container flex h-full items-center gap-4 lg:gap-6 xl:justify-center">
    <!-- Logo - 内联 SVG -->
    <a href="/" class="inline-flex flex-none items-center gap-2 font-semibold tracking-tight text-foreground" aria-label="WeTools 首页">
      <svg width="28" height="28" viewBox="0 0 32 32" fill="none" class="h-7 w-7 flex-none" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <!-- 主体绿色对角渐变（emerald 600 → emerald 400），与首页主标题色一致 -->
          <linearGradient id="logo-grad-base" x1="0" y1="0" x2="32" y2="32" gradientUnits="userSpaceOnUse">
            <stop offset="0%" stop-color="#059669" />
            <stop offset="100%" stop-color="#34D399" />
          </linearGradient>
          <!-- 左上角小范围蓝色高光（径向，仅覆盖左上 1/3） -->
          <radialGradient id="logo-grad-hl" cx="0" cy="0" r="18" gradientUnits="userSpaceOnUse">
            <stop offset="0%" stop-color="#3B82F6" stop-opacity="0.85" />
            <stop offset="60%" stop-color="#3B82F6" stop-opacity="0.15" />
            <stop offset="100%" stop-color="#3B82F6" stop-opacity="0" />
          </radialGradient>
        </defs>
        <rect width="32" height="32" rx="8" fill="url(#logo-grad-base)" />
        <rect width="32" height="32" rx="8" fill="url(#logo-grad-hl)" />
        <g transform="translate(4.5,4.5) scale(0.96)">
          <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
        </g>
      </svg>
      <span class="text-sm">WeTools</span>
    </a>

    <!-- 桌面端：分类下拉导航（Astro 静态） -->
    <nav class="hidden xl:flex items-center gap-0.5" aria-label="分类导航">
      {groups.map((g) => (
        <div class="nav-dropdown relative">
          <button
            type="button"
            class="inline-flex items-center gap-1 whitespace-nowrap rounded-md px-2.5 py-1.5 text-[13px] text-muted-foreground transition-colors hover:text-foreground hover:bg-secondary"
          >
            {g.category.i18n.zh.title}
            <svg class="h-3 w-3 opacity-40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="nav-dropdown-menu absolute left-0 top-full hidden min-w-[200px] animate-pop-in rounded-lg border bg-popover p-1.5 shadow-lg">
            {g.tools.map((t) => (
              <a
                href={`/${t.id}`}
                class="flex items-center rounded-md px-2.5 py-1.5 text-[13px] text-popover-foreground/80 transition-colors hover:bg-secondary hover:text-foreground"
              >
                {t.i18n.zh.title}
              </a>
            ))}
          </div>
        </div>
      ))}
    </nav>

    <!-- 移动端汉堡按钮 -->
    <button
      id="mobile-nav-toggle"
      type="button"
      class="xl:hidden inline-flex h-9 w-9 items-center justify-center rounded-md text-muted-foreground hover:bg-secondary hover:text-foreground"
      aria-label="打开菜单"
      aria-expanded="false"
    >
      <Menu :size="18" />
    </button>

    <!-- 右侧操作组：xl 以下用 ml-auto 推到最右，xl+ 跟随整体居中 -->
    <div class="ml-auto xl:ml-0 flex flex-none items-center gap-1.5">
      <SearchTrigger client:load />
      <LangSwitch client:load />
      <ThemeToggle client:load />
    </div>
  </div>

  <!-- 移动端遮罩 -->
  <div
    id="mobile-nav-backdrop"
    class="xl:hidden hidden fixed inset-0 top-14 z-40 bg-background/60 backdrop-blur-sm"
  ></div>

  <!-- 移动端展开面板 -->
  <div
    id="mobile-nav-panel"
    class="xl:hidden hidden fixed left-0 right-0 top-14 z-50 border-b bg-background shadow-xl max-h-[calc(100vh-3.5rem)] overflow-y-auto"
  >
    <nav class="container py-4">
      {groups.map((g) => (
        <div class="mb-5 last:mb-0">
          <div class="mb-2 text-[10px] font-bold uppercase tracking-wider text-muted-foreground">
            {g.category.i18n.zh.title}
          </div>
          <div class="grid grid-cols-2 gap-1 sm:grid-cols-3">
            {g.tools.map((t) => (
              <a
                href={`/${t.id}`}
                class="block truncate rounded-md px-2 py-1.5 text-[13px] text-foreground/80 transition-colors hover:bg-secondary hover:text-foreground"
              >
                {t.i18n.zh.title}
              </a>
            ))}
          </div>
        </div>
      ))}
    </nav>
  </div>
</header>

<style>
  .nav-dropdown:hover .nav-dropdown-menu,
  .nav-dropdown:focus-within .nav-dropdown-menu {
    display: block;
  }
  .nav-dropdown-menu {
    padding-top: 6px;
    margin-top: -6px;
  }
</style>

<script>
  function initMobileNav() {
    const btn = document.getElementById('mobile-nav-toggle');
    const panel = document.getElementById('mobile-nav-panel');
    const backdrop = document.getElementById('mobile-nav-backdrop');
    if (!btn || !panel || !backdrop) return;
    if (btn.dataset.bound === '1') return;
    btn.dataset.bound = '1';

    const close = () => {
      panel.classList.add('hidden');
      backdrop.classList.add('hidden');
      btn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    };
    const open = () => {
      panel.classList.remove('hidden');
      backdrop.classList.remove('hidden');
      btn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    };
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      panel.classList.contains('hidden') ? open() : close();
    });
    panel.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) close();
    });
    backdrop.addEventListener('click', close);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.classList.contains('hidden')) close();
    });
    const mq = window.matchMedia('(min-width: 1280px)');
    mq.addEventListener('change', (e) => {
      if (e.matches) close();
    });
  }
  initMobileNav();
  document.addEventListener('astro:after-swap', initMobileNav);
</script>
