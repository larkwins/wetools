---
import ToolLayout from '@/layouts/ToolLayout.astro';
import ToolMount from '@/components/layout/ToolMount.vue';
import { allTools } from '@/lib/registry';
import type { ToolMeta } from '@/lib/types';

export function getStaticPaths() {
  return allTools.map((meta) => ({
    params: { tool: meta.id },
    props: { meta },
  }));
}

interface Props {
  meta: ToolMeta;
}

const { meta } = Astro.props as Props;
---

<ToolLayout meta={meta}>
  <!-- ToolMount 内部用 async setup + import.meta.glob 静态选出对应 Tool.vue。
       SSR 阶段 Vue 会 await import，把工具完整骨架渲染进 HTML（含 CodeEditor 占位）。
       客户端 hydrate 时也是同一份组件树，无空白窗口。 -->
  <ToolMount client:load meta={meta} />
</ToolLayout>
