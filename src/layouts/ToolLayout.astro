---
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '@/components/layout/SiteHeader.astro';
import SiteFooter from '@/components/layout/SiteFooter.astro';
import ToolActions from '@/components/layout/ToolActions.vue';
import RelatedTools from '@/components/layout/RelatedTools.vue';
import { relatedTools } from '@/lib/registry';
import type { ToolMeta } from '@/lib/types';
import { ShieldCheck, Globe2 } from 'lucide-vue-next';

export interface Props {
  meta: ToolMeta;
}

const { meta } = Astro.props;
const related = relatedTools(meta);
const i18n = meta.i18n.zh;
const isExternal = meta.privacy === 'external';
---

<BaseLayout title={`${i18n.title} · WeTools`} description={i18n.description}>
  <SiteHeader />

  <div class="container pt-8 pb-6 flex-1">
    <main class="mx-auto max-w-4xl">
      <!-- 标题区（Astro 静态渲染，无 hydrate 闪烁） -->
      <header class="flex flex-col gap-4 border-b pb-6">
        <div class="flex items-start justify-between gap-4">
          <div class="min-w-0 flex-1">
            <h1 class="text-2xl font-bold tracking-tight">{i18n.title}</h1>
            <p class="mt-2 max-w-2xl text-sm text-muted-foreground">{i18n.description}</p>
            <div class="mt-3 flex flex-wrap items-center gap-2">
              {!isExternal ? (
                <span class="badge badge-success">
                  <ShieldCheck size={12} />
                  本地处理
                </span>
              ) : (
                <span class="badge badge-warning">
                  <Globe2 size={12} />
                  调用外部 API
                </span>
              )}
              {meta.tags?.includes('new') && (
                <span class="inline-flex items-center rounded-full border border-blue-500/20 bg-blue-500/10 px-2 py-0.5 text-[11px] font-medium text-blue-600 dark:text-blue-400">NEW</span>
              )}
            </div>
          </div>
          <!-- 收藏/复制 — 占位避免布局跳动 -->
          <div class="flex flex-none items-center gap-2 w-[72px] h-8">
            <ToolActions client:load toolId={meta.id} />
          </div>
        </div>
      </header>

      <div class="mt-6">
        <slot />
      </div>

      <RelatedTools client:visible related={related} />
    </main>
  </div>

  <SiteFooter />
</BaseLayout>
