---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteHeader from '@/components/layout/SiteHeader.astro';
import SiteFooter from '@/components/layout/SiteFooter.astro';
import FavoriteButton from '@/components/ui/FavoriteButton.vue';
import { groupedByCategory, allTools } from '@/lib/registry';
import { getIcon } from '@/lib/icons';
import { Star, ClipboardList, Search, Coffee } from 'lucide-vue-next';

const groups = groupedByCategory();
const Ico = getIcon;

const categoryColors: Record<string, { icon: string; iconBg: string; hover: string }> = {
  encoding:  { icon: 'text-blue-500',    iconBg: 'bg-blue-500/10',    hover: 'group-hover:text-blue-500' },
  json:      { icon: 'text-emerald-500', iconBg: 'bg-emerald-500/10', hover: 'group-hover:text-emerald-500' },
  crypto:    { icon: 'text-purple-500',  iconBg: 'bg-purple-500/10',  hover: 'group-hover:text-purple-500' },
  datetime:  { icon: 'text-orange-500',  iconBg: 'bg-orange-500/10',  hover: 'group-hover:text-orange-500' },
  generator: { icon: 'text-cyan-500',    iconBg: 'bg-cyan-500/10',    hover: 'group-hover:text-cyan-500' },
  image:     { icon: 'text-pink-500',    iconBg: 'bg-pink-500/10',    hover: 'group-hover:text-pink-500' },
  text:      { icon: 'text-amber-500',   iconBg: 'bg-amber-500/10',   hover: 'group-hover:text-amber-500' },
  network:   { icon: 'text-teal-500',    iconBg: 'bg-teal-500/10',    hover: 'group-hover:text-teal-500' },
  dev:       { icon: 'text-indigo-500',  iconBg: 'bg-indigo-500/10',  hover: 'group-hover:text-indigo-500' },
};
const defaultColor = { icon: 'text-primary', iconBg: 'bg-primary/10', hover: 'group-hover:text-primary' };
---

<BaseLayout home>
  <SiteHeader />

  <main class="flex-1">
    <!-- Hero - 居中放大，作为首页视觉重点 -->
    <section class="container pt-6 pb-10 sm:pt-10 sm:pb-14">
      <div class="mx-auto max-w-3xl text-center">
        <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-emerald-500/20 bg-emerald-500/10 px-3.5 py-1 text-xs font-medium text-emerald-600 dark:text-emerald-400">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
          100% 本地运行 · 不上传任何数据
        </div>
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl">
          程序员的<span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-600 to-emerald-400">浏览器工具箱</span>
        </h1>
        <p class="mx-auto mt-5 max-w-2xl text-base text-muted-foreground leading-relaxed sm:text-[15px]">
          常用开箱即用的开发者工具：JSON、Base64、加密哈希、二维码、时间戳、正则、图片压缩…… 全部在你的浏览器本地完成，开源、免费、无追踪。
        </p>

        <!-- CTA 按钮组 -->
        <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
          <!-- 快捷搜索：点击触发 CommandPalette；快捷键提示由站点 ⌘K 一致 -->
          <button
            id="hero-search-trigger"
            type="button"
            class="inline-flex h-10 items-center gap-2 rounded-md bg-emerald-600 px-4 text-sm font-medium text-white shadow-sm transition-all hover:bg-emerald-700 hover:shadow"
          >
            <Search size={15} />
            快捷搜索
            <kbd class="ml-1 hidden sm:inline-flex h-5 items-center rounded border border-white/30 bg-white/15 px-1.5 font-mono text-[10px] tracking-wider">⌘K</kbd>
          </button>

          <!-- Buy Me A Coffee：先占位，链接稍后替换为真实地址 -->
          <a
            href="#"
            data-bmc-placeholder
            class="inline-flex h-10 items-center gap-2 rounded-md border bg-card px-4 text-sm font-medium text-foreground transition-all hover:border-amber-500/60 hover:text-amber-600 hover:shadow-sm dark:hover:text-amber-400"
          >
            <Coffee size={15} class="text-amber-500" />
            Buy Me A Coffee
          </a>
        </div>
      </div>
    </section>

    <!-- Hero 内的快捷搜索按钮：客户端触发 ⌘K 命令面板 -->
    <script is:inline>
      document.getElementById('hero-search-trigger')?.addEventListener('click', function () {
        window.dispatchEvent(new CustomEvent('wetools:openPalette'));
      });
    </script>

    <section class="container space-y-12 pb-20">
      <!-- 我的收藏 —— 完全静态预渲染，由内联同步脚本从 localStorage 填充 -->
      <!--
        实现思路（避免 Vue hydrate 延迟导致 "先空状态再出现收藏卡片"）：
          1. Astro 在 SSR 阶段为每个工具卡片打上 data-tool-id，渲染到各分类下；
          2. 这里输出一个空的收藏外壳（标题 + 空状态 + 卡片容器，二者用 hidden 切换）；
          3. 紧跟一段 <script is:inline>，body 解析到这里时同步执行：
             - 读 localStorage 中的 wetools:favorites
             - 在 DOM 中找到对应 [data-tool-id] 卡片，克隆到 #favorites-grid
             - 若有收藏 → 显示卡片网格、隐藏空状态、显示计数 badge
          4. 整个过程在浏览器解析 HTML 时同步完成，无需等 Vue / JS chunk 下载。
      -->
      <div class="favorites-shell">
        <!-- items-center 让文字组合（标题 + 简介）整体与图标垂直居中对齐 -->
        <div class="mb-5 flex items-center gap-3">
          <span class="inline-flex h-10 w-10 flex-none items-center justify-center rounded-lg bg-amber-500/10">
            <Star size={20} class="text-amber-500" fill="currentColor" stroke-width={1.5} />
          </span>
          <div class="min-w-0">
            <div class="flex items-center gap-2">
              <h2 class="text-base font-semibold text-foreground leading-tight sm:text-lg">我的收藏</h2>
              <span id="favorites-count" style="display:none" class="rounded-full bg-secondary px-2 py-0.5 text-[11px] text-muted-foreground">
                0
              </span>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">常用工具一键直达</p>
          </div>
        </div>

        <!-- 卡片网格容器（同步脚本会往里 clone 卡片） -->
        <div id="favorites-grid" style="display:none" class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4"></div>

        <!-- 空状态：结构与 .tool-card 完全对齐（同样 p-4 + flex items-center gap-3 + h-8 图标 + 两行文字），
             保证高度与工具卡片完全一致，避免点击收藏后产生纵向跳动 -->
        <div id="favorites-empty" class="tool-card !cursor-default border-dashed bg-card/40 hover:!border-border hover:!bg-card/40 hover:!shadow-none">
          <div class="flex items-center gap-3">
            <span class="inline-flex h-8 w-8 flex-none items-center justify-center rounded-md bg-secondary text-muted-foreground/70">
              <ClipboardList size={15} />
            </span>
            <div class="min-w-0 flex-1">
              <p class="truncate text-sm font-medium text-foreground/70">还没有收藏任何工具</p>
              <p class="truncate text-xs text-muted-foreground mt-0.5">
                点击工具卡片右上角的
                <Star size={11} class="inline-block -mt-0.5 text-amber-500" />
                即可收藏
              </p>
            </div>
          </div>
        </div>
      </div>

      {groups.map((g) => {
        const CatIcon = Ico(g.category.icon);
        const colors = categoryColors[g.category.id] ?? defaultColor;
        return (
          <div id={g.category.id}>
            <!-- items-center 让标题+简介整体与图标垂直居中对齐 -->
            <div class="mb-5 flex items-center gap-3">
              <span class={`inline-flex h-10 w-10 flex-none items-center justify-center rounded-lg ${colors.iconBg}`}>
                <CatIcon size={20} class={colors.icon} />
              </span>
              <div class="min-w-0">
                <div class="flex items-center gap-2">
                  <h2 class="text-base font-semibold text-foreground leading-tight sm:text-lg">
                    {g.category.i18n.zh.title}
                  </h2>
                  <span class="rounded-full bg-secondary px-2 py-0.5 text-[11px] text-muted-foreground">
                    {g.tools.length}
                  </span>
                </div>
                <p class="mt-0.5 text-xs text-muted-foreground">
                  {g.category.i18n.zh.description}
                </p>
              </div>
            </div>

            <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
              {g.tools.map((t) => {
                const ToolIco = Ico(t.icon);
                return (
                  <a href={`/${t.id}`} data-tool-id={t.id} class="group tool-card relative cursor-pointer">
                    <div class="flex items-center gap-3">
                      <span class={`inline-flex h-8 w-8 flex-none items-center justify-center rounded-md bg-secondary text-muted-foreground transition-colors ${colors.hover}`}>
                        <ToolIco size={15} />
                      </span>
                      <div class="min-w-0 flex-1 pr-7">
                        <p class="truncate text-sm font-medium text-foreground">{t.i18n.zh.title}</p>
                        <p class="truncate text-xs text-muted-foreground mt-0.5">{t.i18n.zh.description}</p>
                      </div>
                    </div>
                    <div class="absolute right-2 top-2">
                      <FavoriteButton client:load toolId={t.id} size="sm" />
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
        );
      })}
    </section>

    <!-- 收藏区同步填充脚本：HTML 解析到此处时立刻执行，避免等 Vue hydrate -->
    <script is:inline>
      (function () {
        function readFavoriteIds() {
          try {
            var raw = localStorage.getItem('wetools:favorites');
            if (!raw) return [];
            var parsed = JSON.parse(raw);
            return Array.isArray(parsed) ? parsed.filter(function (x) { return typeof x === 'string'; }) : [];
          } catch (e) {
            return [];
          }
        }

        // 把分类区里某张原始卡片中的 FavoriteButton 同步点亮/熄灭。
        // 用于解决 SSR 输出 isFav=false → Vue island hydrate 后才变金色的延迟。
        // toolCard: 原始 <a data-tool-id="..."> 元素（即分类网格里的卡片，非 clone）
        function paintFavoriteOnCard(toolCard, isFav) {
          if (!toolCard) return;
          var btn = toolCard.querySelector('button');
          if (!btn) return;
          var svg = btn.querySelector('svg');
          if (isFav) {
            btn.classList.remove('text-muted-foreground/50', 'hover:text-muted-foreground');
            btn.classList.add('text-amber-500', 'hover:text-amber-600');
            if (svg) {
              svg.setAttribute('fill', 'currentColor');
              svg.setAttribute('stroke-width', '1.5');
            }
          } else {
            btn.classList.remove('text-amber-500', 'hover:text-amber-600');
            btn.classList.add('text-muted-foreground/50', 'hover:text-muted-foreground');
            if (svg) {
              svg.setAttribute('fill', 'none');
              svg.setAttribute('stroke-width', '2');
            }
          }
        }

        // 把分类区所有 [data-tool-id] 卡片按当前收藏集合刷新点亮态。
        // Vue hydrate 完成后 isFav computed 会重新计算，渲染结果与此处一致，
        // 所以不会出现"先点亮再闪一下灰再回到金色"的视觉跳变。
        function paintAllCategoryCards(idSet) {
          var cards = document.querySelectorAll('[data-tool-id]');
          for (var i = 0; i < cards.length; i++) {
            var card = cards[i];
            var id = card.getAttribute('data-tool-id');
            paintFavoriteOnCard(card, !!id && idSet[id] === 1);
          }
        }

        function render() {
          var grid = document.getElementById('favorites-grid');
          var empty = document.getElementById('favorites-empty');
          var countEl = document.getElementById('favorites-count');
          if (!grid || !empty) return;

          var ids = readFavoriteIds();
          var idSet = {};
          for (var k = 0; k < ids.length; k++) idSet[ids[k]] = 1;

          // 先同步点亮分类区所有已收藏卡片的星标按钮
          paintAllCategoryCards(idSet);

          // 清空当前收藏区
          while (grid.firstChild) grid.removeChild(grid.firstChild);

          // 把克隆卡片里的 FavoriteButton 强制改为"已收藏"点亮态，
          // 并接管它的点击事件（克隆 DOM 不在 Vue 控制下）。
          function markFavoritedInClone(cloneEl, toolId) {
            var btn = cloneEl.querySelector('button');
            if (!btn) return;
            // 视觉：text-muted-foreground/50 hover:text-muted-foreground
            //   → text-amber-500 hover:text-amber-600；svg fill 改实心
            btn.classList.remove('text-muted-foreground/50', 'hover:text-muted-foreground');
            btn.classList.add('text-amber-500', 'hover:text-amber-600');
            var svg = btn.querySelector('svg');
            if (svg) {
              svg.setAttribute('fill', 'currentColor');
              svg.setAttribute('stroke-width', '1.5');
            }
            // 接管点击：取消收藏（写 localStorage + 派发同标签 storage 事件，
            // 让所有 Vue island 里的 useStorage 同步取消点亮）
            btn.addEventListener('click', function (e) {
              e.preventDefault();
              e.stopPropagation();
              try {
                var KEY = 'wetools:favorites';
                var raw = localStorage.getItem(KEY);
                var arr = raw ? JSON.parse(raw) : [];
                if (!Array.isArray(arr)) arr = [];
                var prev = JSON.stringify(arr);
                var next = arr.filter(function (x) { return x !== toolId; });
                var nextStr = JSON.stringify(next);
                localStorage.setItem(KEY, nextStr);
                // 自定义事件：触发首页"我的收藏"区重新渲染
                window.dispatchEvent(new CustomEvent('wetools:favoritesChanged', {
                  detail: { favorites: next }
                }));
                // 同标签 storage 事件：触发所有 island 内 useStorage 同步
                // 注意 StorageEvent 必须用 init 字典构造
                try {
                  window.dispatchEvent(new StorageEvent('storage', {
                    key: KEY,
                    oldValue: prev,
                    newValue: nextStr,
                    storageArea: localStorage,
                    url: window.location.href,
                  }));
                } catch (_) { /* 老浏览器 ignore */ }
              } catch (err) { /* ignore */ }
            });
          }

          var added = 0;
          for (var i = 0; i < ids.length; i++) {
            var id = ids[i];
            // tool id 都是 kebab-case 安全字符
            var src = document.querySelector('[data-tool-id="' + id.replace(/"/g, '') + '"]');
            if (!src) continue;
            var clone = src.cloneNode(true);
            clone.removeAttribute('data-tool-id'); // 避免下次再被选中、克隆嵌套
            markFavoritedInClone(clone, id);
            grid.appendChild(clone);
            added++;
          }
          // 注意：grid / empty 是 Tailwind 的 grid / flex 容器，
          // HTML 原生 hidden 属性等价 display:none，但会被 class 中的 display:grid/flex
          // 覆盖，所以必须用 inline style 强制隐藏（特异性更高）。
          function setVisible(el, visible) {
            if (visible) el.style.display = '';
            else el.style.display = 'none';
            el.removeAttribute('hidden');
          }
          if (added > 0) {
            setVisible(grid, true);
            setVisible(empty, false);
            if (countEl) {
              countEl.textContent = String(added);
              setVisible(countEl, true);
            }
          } else {
            setVisible(grid, false);
            setVisible(empty, true);
            if (countEl) setVisible(countEl, false);
          }
        }

        // 首屏立刻执行
        render();
        // 收藏变化时刷新（FavoriteButton 在 toggle 时会派发此事件）
        window.addEventListener('wetools:favoritesChanged', render);
        // 跨标签同步：另一个标签修改了 localStorage 也刷新
        window.addEventListener('storage', function (e) {
          if (e.key === 'wetools:favorites') render();
        });
      })();
    </script>
  </main>

  <SiteFooter />
</BaseLayout>
