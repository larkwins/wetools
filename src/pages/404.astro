---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteHeader from '@/components/layout/SiteHeader.astro';
import SiteFooter from '@/components/layout/SiteFooter.astro';
import { allTools } from '@/lib/registry';
import { getIcon } from '@/lib/icons';
import { Search } from 'lucide-vue-next';

const popular = allTools.filter((t) => t.tags?.includes('hot')).slice(0, 4);
const fallback = allTools.slice(0, 4);
const recommended = popular.length > 0 ? popular : fallback;
const Ico = getIcon;
---

<BaseLayout title="404 · WeTools" description="页面没找到">
  <SiteHeader />
  <main class="container flex min-h-[60vh] flex-col items-center justify-center py-16 text-center">
    <p class="font-mono text-xs uppercase tracking-widest text-primary">404</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight">页面没找到</h1>
    <p class="mt-3 max-w-md text-sm text-muted-foreground">
      你想访问的页面可能已被移除，或链接拼写有误。从下面继续探索吧。
    </p>

    <button
      id="palette-trigger"
      class="mt-8 inline-flex h-10 items-center gap-2 rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground shadow-soft-sm transition-all hover:opacity-90"
    >
      <Search size={14} />
      搜索工具
      <kbd class="ml-1 rounded border border-primary-foreground/30 bg-primary-foreground/10 px-1.5 font-mono text-[11px]">⌘K</kbd>
    </button>

    {recommended.length > 0 && (
      <div class="mt-12 grid w-full max-w-2xl gap-3 sm:grid-cols-2">
        {recommended.map((t) => {
          const I = Ico(t.icon);
          return (
            <a href={`/${t.id}`} class="group tool-card text-left">
              <div class="flex items-start gap-3">
                <span class="mt-0.5 inline-flex h-9 w-9 flex-none items-center justify-center rounded-md bg-secondary text-foreground/70 group-hover:bg-primary/10 group-hover:text-primary">
                  <I size={18} />
                </span>
                <div class="min-w-0">
                  <p class="truncate text-sm font-semibold">{t.i18n.zh.title}</p>
                  <p class="mt-1 line-clamp-2 text-xs text-muted-foreground">{t.i18n.zh.description}</p>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    )}
  </main>
  <SiteFooter />

  <script is:inline>
    document.getElementById('palette-trigger')?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('wetools:openPalette'));
    });
  </script>
</BaseLayout>
